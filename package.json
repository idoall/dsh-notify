{
  "name": "@idoall/dsh-notify",
  "version": "0.4.0",
  "type": "module",
  "description": "DSH web plugin: in-page task notifications for DeepSeek Harness — enhanced or soft status toasts, a collapsible top-right stack, answer buttons, background-tab attention, and a WebAudio cue that also plays while the page is hidden. Live delivery only: no history, no service worker, no web push, no OS notification matrix.",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.1.7-rc.1 <0.2.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-rc.1": "compatible",
        "0.1.7-rc.2": "compatible"
      }
    }
  },
  "scripts": {
    "typecheck": "node tscheck.mjs && tsc --noEmit",
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run pack:check"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-connection": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/dsh-jobs": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^22.15.29",
    "@types/react": "^18.3.23",
    "esbuild": "^0.25.5",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idoall/dsh-notify.git"
  },
  "homepage": "https://github.com/idoall/dsh-notify#readme",
  "bugs": {
    "url": "https://github.com/idoall/dsh-notify/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "harness",
    "cordis",
    "plugin",
    "notifications",
    "toast",
    "web"
  ]
}
